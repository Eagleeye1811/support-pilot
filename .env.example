# Optional: enables LLM tie-breaking for ambiguous intents and reply polishing.
# Every decision stays deterministic; keep real credentials in .env or Streamlit secrets, never in Git.
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
