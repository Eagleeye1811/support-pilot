# LLM (Groq, OpenAI-compatible). Without a key SupportPilot runs in deterministic fallback mode.
GROQ_API_KEY = "your_key_here"
GROQ_MODEL = "openai/gpt-oss-120b"
# Tried in order if GROQ_MODEL is retired or not enabled for the key:
# GROQ_FALLBACK_MODELS = "openai/gpt-oss-120b,openai/gpt-oss-20b"

# Recommended whenever the dashboard is reachable by others (it can approve refunds):
# SUPPORTPILOT_DASHBOARD_PASSWORD = "choose-a-long-password"

# Optional: real Telegram bot from @BotFather (see README → "Real Telegram bot")
TELEGRAM_BOT_TOKEN = "your_token_here"

# Optional: Email agent (Gmail SMTP). SMTP_PASSWORD is a Google App Password, not your normal password:
# Google Account → Security → 2-Step Verification → App passwords.
SMTP_USER = "you@gmail.com"
SMTP_PASSWORD = "your_app_password"
